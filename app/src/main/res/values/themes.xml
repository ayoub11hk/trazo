<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="graphite">#0E1014</color>
    <color name="volt">#B8FF3C</color>
    <style name="Theme.Trazo" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/graphite</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.Trazo.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/graphite</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Trazo</item>
    </style>
</resources>
