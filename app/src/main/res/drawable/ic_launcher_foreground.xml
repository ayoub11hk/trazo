<?xml version="1.0" encoding="utf-8"?>
<!-- Trazo mark: a GPS trace sweeping into a "T", ending in a live-position dot. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <!-- crossbar of the T -->
    <path android:pathData="M34,38 L74,38"
        android:strokeColor="#F2F4F7" android:strokeWidth="7" android:strokeLineCap="round" />
    <!-- the trace: stem of the T bending into a road curve -->
    <path android:pathData="M54,38 L54,58 C54,70 46,74 38,76"
        android:strokeColor="#B8FF3C" android:strokeWidth="7" android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <path android:pathData="M54,58 C54,66 60,70 66,70"
        android:strokeColor="#39C6FF" android:strokeWidth="3" android:strokeLineCap="round"
        android:strokeAlpha="0.85" android:fillColor="#00000000" />
    <!-- live dot with halo -->
    <path android:pathData="M38,76 m-9,0 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0"
        android:fillColor="#B8FF3C" android:fillAlpha="0.25" />
    <path android:pathData="M38,76 m-4.5,0 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0"
        android:fillColor="#B8FF3C" />
</vector>
